# Параметры демонстрационного стенда CRM.
# Скопировать в .env и заменить пароли. Файл .env в репозиторий не попадает.

# Пароль root MySQL (только внутри контейнера)
DB_ROOT_PASSWORD=change_me_root

# Пароль пользователя базы EspoCRM
DB_PASSWORD=change_me_db

# Учётная запись администратора EspoCRM
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# Адрес, по которому открывается система.
# Локально: http://localhost:8080
# На сервере: https://crm.example.ru
SITE_URL=http://localhost:8080

# Порт на хост-машине (локальный запуск)
HTTP_PORT=8080
